# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage/

# next.js
/.next/
/.vinext/
/out/
**/out/

# misc
.DS_Store
.Rhistory
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/build/
/.wrangler/
/outputs/
/output/
/work/
**/dist/
**/build/
**/.sites-runtime/
**/outputs/
**/output/
**/work/

# Sexta 50 keeps a source Vite plugin in a directory named `build`.
!Projetos Pessoais/Sexta 50/build/
!Projetos Pessoais/Sexta 50/build/sites-vite-plugin.ts

# nested project workspaces and generated files
**/node_modules/
**/.npm-cache/
**/.next/
**/.vinext/
**/.wrangler/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]

# Swift and Xcode
**/.build/
**/.swiftpm/
**/DerivedData/
**/xcuserdata/
**/*.xcuserstate
